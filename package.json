{
  "name": "agent-team",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first agent team controller for Linear and GitHub workflows.",
  "type": "module",
  "bin": {
    "agent-team": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -R src/ui/assets dist/ui/",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "schemas:generate": "pnpm run build && node scripts/generate-domain-schemas.mjs",
    "start": "node dist/cli/index.js",
    "test": "pnpm run build && vitest run",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:integration": "vitest run tests/integration --passWithNoTests",
    "test:browser": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.59.1",
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "axe-core": "4.11.0",
    "eslint": "^10.8.0",
    "globals": "^17.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
