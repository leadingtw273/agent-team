{
  "name": "agent-team",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first agent team controller for Linear and GitHub workflows.",
  "type": "module",
  "bin": {
    "agent-team": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
